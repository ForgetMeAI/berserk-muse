# Variables for one isolated Claude Code child process only.
# Pass these to a launcher that replaces the child's environment; do not source
# this file into a persistent shell or add it to global Claude Code settings.
HOME=/tmp/berserk-agent-profile/home
TMPDIR=/tmp/berserk-agent-profile/tmp
CLAUDE_CODE_TMPDIR=/tmp/berserk-agent-profile/tmp
TEMP=/tmp/berserk-agent-profile/tmp
TMP=/tmp/berserk-agent-profile/tmp
CLAUDE_CONFIG_DIR=/tmp/berserk-agent-profile/claude
ANTHROPIC_BASE_URL=http://127.0.0.1:8787
ANTHROPIC_AUTH_TOKEN=muse-local
ANTHROPIC_MODEL=muse-web
ANTHROPIC_DEFAULT_MODEL=muse-web
ANTHROPIC_DEFAULT_OPUS_MODEL=muse-web
ANTHROPIC_DEFAULT_SONNET_MODEL=muse-web
ANTHROPIC_DEFAULT_HAIKU_MODEL=muse-web
ANTHROPIC_DEFAULT_FABLE_MODEL=muse-web
ANTHROPIC_CUSTOM_MODEL_OPTION=muse-web
CLAUDE_CODE_SIMPLE=1
CLAUDE_CODE_MAX_RETRIES=0
DISABLE_TELEMETRY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
